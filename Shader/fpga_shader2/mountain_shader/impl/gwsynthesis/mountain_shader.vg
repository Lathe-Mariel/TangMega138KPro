output tmds_clk_n;
output n36_6;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pixel(clk_pixel),
    .clk_tmds(clk_tmds),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
