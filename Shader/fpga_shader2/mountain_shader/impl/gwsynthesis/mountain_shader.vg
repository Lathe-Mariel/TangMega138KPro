module top (
  clk,
  rst_n,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  state_led
)
;
input clk;
input rst_n;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output [5:0] state_led;
wire clk_d;
wire pll_lock;
wire clk_tmds;
wire clk_pixel;
wire hsync_Z;
wire vsync_Z;
wire n36_6;
wire [1:0] state_led_d;
wire [2:2] state_led_d_3;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(state_led_d[1]),
    .I(rst_n) 
);
  OBUF state_led_0_obuf (
    .O(state_led[0]),
    .I(state_led_d[0]) 
);
  OBUF state_led_1_obuf (
    .O(state_led[1]),
    .I(state_led_d[1]) 
);
  OBUF state_led_2_obuf (
    .O(state_led[2]),
    .I(state_led_d_3[2]) 
);
  TBUF state_led_5_s0 (
    .O(state_led[3]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF state_led_5_s1 (
    .O(state_led[4]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF state_led_5_s2 (
    .O(state_led[5]),
    .I(GND),
    .OEN(VCC) 
);
  LUT2 state_led_d_0_s (
    .F(state_led_d[0]),
    .I0(state_led_d[1]),
    .I1(pll_lock) 
);
defparam state_led_d_0_s.INIT=4'h7;
  Gowin_PLL pll_inst (
    .clk_d(clk_d),
    .n36_6(n36_6),
    .pll_lock(pll_lock),
    .clk_tmds(clk_tmds),
    .clk_pixel(clk_pixel)
);
  video_timing u_timing (
    .clk_pixel(clk_pixel),
    .state_led_d(state_led_d[0]),
    .hsync_Z(hsync_Z),
    .vsync_Z(vsync_Z),
    .state_led_d_0(state_led_d_3[2])
);
  DVI_TX_Top your_instance_name (
    .clk_pixel(clk_pixel),
    .clk_tmds(clk_tmds),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .state_led_d(state_led_d[1]),
    .state_led_d_2(state_led_d_3[2]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6(n36_6),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
