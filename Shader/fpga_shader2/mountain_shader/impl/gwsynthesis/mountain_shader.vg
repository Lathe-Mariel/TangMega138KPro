module DVI_TX_Top (
  clk_pixel,
  clk_tmds,
  vsync_Z,
  hsync_Z,
  state_led_d,
  sphere_value_0,
  sphere_value_1,
  sphere_value_2,
  sphere_value_3,
  sphere_value_4,
  sphere_value_6,
  r_out_5,
  r_out_7,
  state_led_d_2,
  tmds_clk_p,
  tmds_clk_n,
  n36_6,
  tmds_data_p,
  tmds_data_n
)
;
input clk_pixel;
input clk_tmds;
input vsync_Z;
input hsync_Z;
input [1:1] state_led_d;
input sphere_value_0;
input sphere_value_1;
input sphere_value_2;
input sphere_value_3;
input sphere_value_4;
input sphere_value_6;
input r_out_5;
input r_out_7;
input [2:2] state_led_d_2;
output tmds_clk_p;
output tmds_clk_n;
output n36_6;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pixel(clk_pixel),
    .clk_tmds(clk_tmds),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .state_led_d(state_led_d[1]),
    .sphere_value_0(sphere_value_0),
    .sphere_value_1(sphere_value_1),
    .sphere_value_2(sphere_value_2),
    .sphere_value_3(sphere_value_3),
    .sphere_value_4(sphere_value_4),
    .sphere_value_6(sphere_value_6),
    .r_out_5(r_out_5),
    .r_out_7(r_out_7),
    .state_led_d_1(state_led_d_2[2]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6(n36_6),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
  clk,
  rst_n,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  state_led
)
;
input clk;
input rst_n;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output [5:0] state_led;
wire clk_d;
wire pll_lock;
wire clk_tmds;
wire clk_pixel;
wire hsync_Z;
wire vsync_Z;
wire n64_6;
wire n11_12;
wire n56_7;
wire n38_7;
wire n37_7;
wire state_led_d_2_7;
wire n61_8;
wire n60_8;
wire hsync_Z_6;
wire n60_10;
wire n298_10;
wire n121_7;
wire n1379_56;
wire n36_6;
wire [1:0] state_led_d;
wire [10:0] hcount_Z;
wire [10:0] vcount_Z;
wire [2:2] state_led_d_3;
wire [6:0] sphere_value;
wire [7:5] r_out;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(state_led_d[1]),
    .I(rst_n) 
);
  OBUF state_led_0_obuf (
    .O(state_led[0]),
    .I(state_led_d[0]) 
);
  OBUF state_led_1_obuf (
    .O(state_led[1]),
    .I(state_led_d[1]) 
);
  OBUF state_led_2_obuf (
    .O(state_led[2]),
    .I(state_led_d_3[2]) 
);
  TBUF state_led_5_s0 (
    .O(state_led[3]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF state_led_5_s1 (
    .O(state_led[4]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF state_led_5_s2 (
    .O(state_led[5]),
    .I(GND),
    .OEN(VCC) 
);
  LUT2 state_led_d_0_s (
    .F(state_led_d[0]),
    .I0(state_led_d[1]),
    .I1(pll_lock) 
);
defparam state_led_d_0_s.INIT=4'h7;
  Gowin_PLL pll_inst (
    .clk_d(clk_d),
    .n36_6(n36_6),
    .pll_lock(pll_lock),
    .clk_tmds(clk_tmds),
    .clk_pixel(clk_pixel)
);
  video_timing u_timing (
    .clk_pixel(clk_pixel),
    .n298_10(n298_10),
    .n121_7(n121_7),
    .n1379_56(n1379_56),
    .state_led_d(state_led_d[0]),
    .hsync_Z(hsync_Z),
    .vsync_Z(vsync_Z),
    .n64_6(n64_6),
    .n11_12(n11_12),
    .n56_7(n56_7),
    .n38_7(n38_7),
    .n37_7(n37_7),
    .state_led_d_2_7(state_led_d_2_7),
    .n61_8(n61_8),
    .n60_8(n60_8),
    .hsync_Z_6(hsync_Z_6),
    .n60_10(n60_10),
    .hcount_Z(hcount_Z[10:0]),
    .vcount_Z(vcount_Z[10:0]),
    .state_led_d_0(state_led_d_3[2])
);
  shader u_shader (
    .clk_pixel(clk_pixel),
    .state_led_d_2_7(state_led_d_2_7),
    .n60_8(n60_8),
    .n56_7(n56_7),
    .n11_12(n11_12),
    .hsync_Z_6(hsync_Z_6),
    .n60_10(n60_10),
    .n64_6(n64_6),
    .n61_8(n61_8),
    .n38_7(n38_7),
    .n37_7(n37_7),
    .vcount_Z(vcount_Z[10:0]),
    .hcount_Z(hcount_Z[10:0]),
    .n298_10(n298_10),
    .n121_7(n121_7),
    .n1379_56(n1379_56),
    .sphere_value_0(sphere_value[0]),
    .sphere_value_1(sphere_value[1]),
    .sphere_value_2(sphere_value[2]),
    .sphere_value_3(sphere_value[3]),
    .sphere_value_4(sphere_value[4]),
    .sphere_value_6(sphere_value[6]),
    .r_out_5(r_out[5]),
    .r_out_7(r_out[7])
);
  DVI_TX_Top your_instance_name (
    .clk_pixel(clk_pixel),
    .clk_tmds(clk_tmds),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .state_led_d(state_led_d[1]),
    .sphere_value_0(sphere_value[0]),
    .sphere_value_1(sphere_value[1]),
    .sphere_value_2(sphere_value[2]),
    .sphere_value_3(sphere_value[3]),
    .sphere_value_4(sphere_value[4]),
    .sphere_value_6(sphere_value[6]),
    .r_out_5(r_out[5]),
    .r_out_7(r_out[7]),
    .state_led_d_2(state_led_d_3[2]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6(n36_6),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
