module DVI_TX_Top (
  clk_pixel,
  clk_tmds,
  vsync_Z,
  hsync_Z,
  state_led_d,
  sphere_value_0,
  sphere_value_1,
  sphere_value_2,
  sphere_value_3,
  sphere_value_4,
  sphere_value_6,
  r_out_5,
  r_out_7,
  state_led_d_2,
  tmds_clk_p,
  tmds_clk_n,
  n36_6,
  tmds_data_p,
  tmds_data_n
)
;
input clk_pixel;
input clk_tmds;
input vsync_Z;
input hsync_Z;
input [1:1] state_led_d;
input sphere_value_0;
input sphere_value_1;
input sphere_value_2;
input sphere_value_3;
input sphere_value_4;
input sphere_value_6;
input r_out_5;
input r_out_7;
input [2:2] state_led_d_2;
output tmds_clk_p;
output tmds_clk_n;
output n36_6;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pixel(clk_pixel),
    .clk_tmds(clk_tmds),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .state_led_d(state_led_d[1]),
    .sphere_value_0(sphere_value_0),
    .sphere_value_1(sphere_value_1),
    .sphere_value_2(sphere_value_2),
    .sphere_value_3(sphere_value_3),
    .sphere_value_4(sphere_value_4),
    .sphere_value_6(sphere_value_6),
    .r_out_5(r_out_5),
    .r_out_7(r_out_7),
    .state_led_d_1(state_led_d_2[2]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6(n36_6),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
  clk,
  rst_n,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  state_led
)
;
input clk;
input rst_n;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output [5:0] state_led;
wire clk_d;
wire pll_lock;
wire clk_tmds;
wire clk_pixel;
wire hsync_Z;
wire vsync_Z;
wire n38_7;
wire vsync_Z_5;
wire n58_8;
wire n40_8;
wire n38_8;
wire n37_8;
wire n36_8;
wire n35_8;
wire n34_8;
wire n33_8;
wire n32_8;
wire n11_12;
