module DVI_TX_Top (
  clk_pixel,
  clk_tmds,
  vsync_Z,
  hsync_Z,
  state_led_d,
  r_out,
  state_led_d_2,
  g_out,
  tmds_clk_p,
  tmds_clk_n,
  n36_6,
  tmds_data_p,
  tmds_data_n
)
;
input clk_pixel;
input clk_tmds;
input vsync_Z;
input hsync_Z;
input [1:1] state_led_d;
input [7:0] r_out;
input [2:2] state_led_d_2;
input [7:0] g_out;
output tmds_clk_p;
output tmds_clk_n;
output n36_6;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pixel(clk_pixel),
    .clk_tmds(clk_tmds),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .state_led_d(state_led_d[1]),
    .r_out(r_out[7:0]),
    .state_led_d_1(state_led_d_2[2]),
    .g_out(g_out[7:0]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6(n36_6),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
  clk,
  rst_n,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  state_led
)
;
input clk;
input rst_n;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output [5:0] state_led;
wire clk_d;
wire pll_lock;
wire clk_tmds;
wire clk_pixel;
wire vsync_Z;
wire n66_6;
wire n65_6;
wire hsync_Z_4;
wire vsync_Z_5;
wire n64_7;
wire n63_7;
wire n62_7;
wire n38_7;
wire n37_7;
wire n32_7;
wire n11_13;
wire n11_14;
wire n11_15;
wire vsync_Z_6;
wire n62_8;
wire n41_9;
wire n41_10;
wire n32_8;
wire hsync_Z_7;
wire state_led_d_2_9;
wire state_led_d_2_10;
wire n11_17;
wire hsync_Z;
wire n107_10;
wire n116_8;
wire n1315_6;
wire n36_6;
wire [1:0] state_led_d;
wire [11:0] hcount_Z;
wire [10:0] vcount_Z;
wire [2:2] state_led_d_3;
wire [7:0] r_out;
wire [7:0] g_out;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(state_led_d[1]),
    .I(rst_n) 
);
  OBUF state_led_0_obuf (
    .O(state_led[0]),
    .I(state_led_d[0]) 
);
  OBUF state_led_1_obuf (
    .O(state_led[1]),
    .I(state_led_d[1]) 
);
  OBUF state_led_2_obuf (
    .O(state_led[2]),
    .I(state_led_d_3[2]) 
);
  OBUF state_led_3_obuf (
    .O(state_led[3]),
    .I(VCC) 
);
  OBUF state_led_4_obuf (
    .O(state_led[4]),
    .I(VCC) 
);
  OBUF state_led_5_obuf (
    .O(state_led[5]),
    .I(VCC) 
);
  LUT2 state_led_d_0_s (
    .F(state_led_d[0]),
    .I0(state_led_d[1]),
    .I1(pll_lock) 
);
defparam state_led_d_0_s.INIT=4'h7;
  Gowin_PLL pll_inst (
    .clk_d(clk_d),
    .n36_6(n36_6),
