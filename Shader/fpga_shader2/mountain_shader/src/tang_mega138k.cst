//==============================================================
// Physical Constraints – Tang Mega 138K Pro Dock
// Device: GW5AST-LV138FPG676AES  (Arora-V, 138K LUT, 676-FBGA)
//
// HDMI connector pinout (LVDS pairs):
//   Tang Mega 138K Pro uses the HDMI port wired directly to
//   the FPGA LVDS I/O pins listed below.
//   Verify against your specific board schematic revision.
//==============================================================

// ── Onboard 27 MHz oscillator ─────────────────────────────
IO_LOC "clk"  P16;
IO_PORT "clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// ── Reset button (active-low, usually KEY0) ────────────────
IO_LOC "rst_n"  K16;
IO_PORT "rst_n" PULL_MODE=UP IO_TYPE=LVCMOS33;


// TMDS Clock Output
IO_LOC  "tmds_clk_p"       Y22,Y23;
IO_PORT "tmds_clk_p"       IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

// TMDS Data Lane 0 (Blue channel)
IO_LOC  "tmds_data_p[0]"   AB24,AC24;
IO_PORT "tmds_data_p[0]"   IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

// TMDS Data Lane 1 (Green channel)
IO_LOC  "tmds_data_p[1]"   V24,W24;
IO_PORT "tmds_data_p[1]"   IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

// TMDS Data Lane 2 (Red channel)
IO_LOC  "tmds_data_p[2]"   AA22,AA23;
IO_PORT "tmds_data_p[2]"   IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

//==============================================================
// IMPORTANT: Cross-check pin assignments with the official
// Tang Mega 138K Pro Dock schematic from Sipeed before
// programming the device.  Incorrect LVDS pin assignments can
// cause permanent damage.
//==============================================================
