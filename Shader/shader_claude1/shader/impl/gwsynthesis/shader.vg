module DVI_TX_Top (
  clk_pix,
  clk_ser,
  rst_n_d,
  de_Z,
  vsync_Z,
  hsync_Z,
  shader_output,
  hdmi_tx_clk_p,
  hdmi_tx_clk_n,
  n36_6,
  hdmi_tx_p,
  hdmi_tx_n
)
;
input clk_pix;
input clk_ser;
input rst_n_d;
input de_Z;
input vsync_Z;
input hsync_Z;
input [15:0] shader_output;
output hdmi_tx_clk_p;
output hdmi_tx_clk_n;
output n36_6;
output [2:0] hdmi_tx_p;
output [2:0] hdmi_tx_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pix(clk_pix),
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .de_Z(de_Z),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .shader_output(shader_output[15:0]),
    .hdmi_tx_clk_p(hdmi_tx_clk_p),
    .hdmi_tx_clk_n(hdmi_tx_clk_n),
    .n36_6(n36_6),
    .hdmi_tx_p(hdmi_tx_p[2:0]),
    .hdmi_tx_n(hdmi_tx_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
