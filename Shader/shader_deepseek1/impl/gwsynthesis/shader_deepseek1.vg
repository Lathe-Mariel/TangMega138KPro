module DVI_TX_Top (
  clk_pix,
  clk_ser,
  rst_n_d,
  r_7_5,
  de_Z,
  g_7_6,
  b_7_6,
  vsync_Z,
  hsync_Z,
  hdmi_tx_clk_p,
  hdmi_tx_clk_n,
  n36_6,
  hdmi_tx_p,
  hdmi_tx_n
)
;
input clk_pix;
input clk_ser;
input rst_n_d;
input r_7_5;
input de_Z;
input g_7_6;
input b_7_6;
input vsync_Z;
input hsync_Z;
output hdmi_tx_clk_p;
output hdmi_tx_clk_n;
output n36_6;
output [2:0] hdmi_tx_p;
output [2:0] hdmi_tx_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pix(clk_pix),
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .r_7_5(r_7_5),
    .de_Z(de_Z),
    .g_7_6(g_7_6),
    .b_7_6(b_7_6),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .hdmi_tx_clk_p(hdmi_tx_clk_p),
    .hdmi_tx_clk_n(hdmi_tx_clk_n),
    .n36_6(n36_6),
    .hdmi_tx_p(hdmi_tx_p[2:0]),
    .hdmi_tx_n(hdmi_tx_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
  clk_50m,
  rst_n,
  leds,
  hdmi_tx_clk_p,
  hdmi_tx_clk_n,
  hdmi_tx_p,
  hdmi_tx_n
)
;
input clk_50m;
input rst_n;
input [7:0] leds;
output hdmi_tx_clk_p;
output hdmi_tx_clk_n;
output [2:0] hdmi_tx_p;
output [2:0] hdmi_tx_n;
wire clk_50m_d;
wire rst_n_d;
wire n11_5;
wire rst_pix;
wire pll_lock;
wire clk_ser;
wire clk_pix;
wire de_Z;
wire hsync_Z;
wire vsync_Z;
wire n11_11;
wire n11_12;
wire hsync_Z_5;
wire hsync_Z_7;
wire r_7_5;
wire g_7_6;
wire b_7_6;
wire n36_6;
wire [2:0] state;
wire [11:0] hcount;
wire VCC;
wire GND;
  IBUF clk_50m_ibuf (
    .O(clk_50m_d),
    .I(clk_50m) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  LUT4 n11_s2 (
    .F(n11_5),
    .I0(state[0]),
    .I1(state[1]),
    .I2(state[2]),
    .I3(pll_lock) 
);
defparam n11_s2.INIT=16'h7FFF;
  DFFSE rst_pix_s0 (
    .Q(rst_pix),
    .D(n11_5),
    .CLK(clk_pix),
    .SET(n36_6),
    .CE(VCC) 
);
  Gowin_PLL u_pll (
    .clk_50m_d(clk_50m_d),
    .n36_6(n36_6),
    .pll_lock(pll_lock),
    .clk_ser(clk_ser),
    .state(state[2:0])
);
  Gowin_CLKDIV u_divider (
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .clk_pix(clk_pix)
);
  vga_timing u_timing (
    .clk_pix(clk_pix),
    .rst_pix(rst_pix),
    .de_Z(de_Z),
    .hsync_Z(hsync_Z),
    .vsync_Z(vsync_Z),
    .n11_11(n11_11),
    .n11_12(n11_12),
    .hsync_Z_5(hsync_Z_5),
    .hsync_Z_7(hsync_Z_7),
    .hcount(hcount[11:0])
);
  color_bar u_color_bar (
    .hsync_Z_5(hsync_Z_5),
    .n11_12(n11_12),
    .hsync_Z_7(hsync_Z_7),
    .n11_11(n11_11),
    .hcount(hcount[11:0]),
    .r_7_5(r_7_5),
    .g_7_6(g_7_6),
    .b_7_6(b_7_6)
);
  DVI_TX_Top u_dvi_tx (
    .clk_pix(clk_pix),
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .r_7_5(r_7_5),
    .de_Z(de_Z),
    .g_7_6(g_7_6),
    .b_7_6(b_7_6),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .hdmi_tx_clk_p(hdmi_tx_clk_p),
    .hdmi_tx_clk_n(hdmi_tx_clk_n),
    .n36_6(n36_6),
    .hdmi_tx_p(hdmi_tx_p[2:0]),
    .hdmi_tx_n(hdmi_tx_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
