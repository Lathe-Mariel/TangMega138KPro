    .hdmi_tx_clk_p(hdmi_tx_clk_p),
    .hdmi_tx_clk_n(hdmi_tx_clk_n),
    .n36_6(n36_6),
    .hdmi_tx_p(hdmi_tx_p[2:0]),
    .hdmi_tx_n(hdmi_tx_n[2:0])
);
