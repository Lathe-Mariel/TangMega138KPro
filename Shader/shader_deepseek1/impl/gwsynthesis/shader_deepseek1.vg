module DVI_TX_Top (
  clk_pix,
  clk_ser,
  rst_n_d,
  de_Z,
  vsync_Z,
  hsync_Z,
  r_Z,
  g_Z,
  b_Z,
  hdmi_tx_clk_p,
  hdmi_tx_clk_n,
  n36_6,
  hdmi_tx_p,
  hdmi_tx_n
)
;
input clk_pix;
input clk_ser;
input rst_n_d;
input de_Z;
input vsync_Z;
input hsync_Z;
input [7:0] r_Z;
input [7:0] g_Z;
input [7:0] b_Z;
output hdmi_tx_clk_p;
output hdmi_tx_clk_n;
output n36_6;
output [2:0] hdmi_tx_p;
output [2:0] hdmi_tx_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .clk_pix(clk_pix),
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .de_Z(de_Z),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .r_Z(r_Z[7:0]),
    .g_Z(g_Z[7:0]),
    .b_Z(b_Z[7:0]),
    .hdmi_tx_clk_p(hdmi_tx_clk_p),
    .hdmi_tx_clk_n(hdmi_tx_clk_n),
    .n36_6(n36_6),
    .hdmi_tx_p(hdmi_tx_p[2:0]),
    .hdmi_tx_n(hdmi_tx_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
  clk_50m,
  rst_n,
  leds,
  hdmi_tx_clk_p,
  hdmi_tx_clk_n,
  hdmi_tx_p,
  hdmi_tx_n
)
;
input clk_50m;
input rst_n;
input [7:0] leds;
output hdmi_tx_clk_p;
output hdmi_tx_clk_n;
output [2:0] hdmi_tx_p;
output [2:0] hdmi_tx_n;
wire clk_50m_d;
wire rst_n_d;
wire n11_5;
wire rst_pix;
wire pll_lock;
wire clk_ser;
wire clk_pix;
wire n11_9;
wire de_Z;
wire hsync_Z;
wire vsync_Z;
wire n43_7;
wire n42_7;
wire n41_7;
wire n40_7;
wire n39_7;
wire n38_7;
wire n37_7;
wire n36_7;
wire n35_7;
wire n34_7;
wire n33_7;
wire n38_8;
wire n35_8;
wire de_Z_6;
wire n44_9;
wire sun_dx_4_4;
wire n36_6;
wire [2:0] state;
wire [11:0] hcount;
wire [9:0] vcount;
wire [7:0] b_Z;
wire [7:0] g_Z;
wire [7:0] r_Z;
wire VCC;
wire GND;
  IBUF clk_50m_ibuf (
    .O(clk_50m_d),
    .I(clk_50m) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  LUT4 n11_s2 (
    .F(n11_5),
    .I0(state[0]),
    .I1(state[1]),
    .I2(state[2]),
    .I3(pll_lock) 
);
defparam n11_s2.INIT=16'h7FFF;
  DFFSE rst_pix_s0 (
    .Q(rst_pix),
    .D(n11_5),
    .CLK(clk_pix),
    .SET(n36_6),
    .CE(VCC) 
);
  Gowin_PLL u_pll (
    .clk_50m_d(clk_50m_d),
    .n36_6(n36_6),
    .pll_lock(pll_lock),
    .clk_ser(clk_ser),
    .state(state[2:0])
);
  Gowin_CLKDIV u_divider (
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .clk_pix(clk_pix)
);
  vga_timing u_timing (
    .clk_pix(clk_pix),
    .rst_pix(rst_pix),
    .sun_dx_4_4(sun_dx_4_4),
    .n11_9(n11_9),
    .de_Z(de_Z),
    .hsync_Z(hsync_Z),
    .vsync_Z(vsync_Z),
    .n43_7(n43_7),
    .n42_7(n42_7),
    .n41_7(n41_7),
    .n40_7(n40_7),
    .n39_7(n39_7),
    .n38_7(n38_7),
    .n37_7(n37_7),
    .n36_7(n36_7),
    .n35_7(n35_7),
    .n34_7(n34_7),
    .n33_7(n33_7),
    .n38_8(n38_8),
    .n35_8(n35_8),
    .de_Z_6(de_Z_6),
    .n44_9(n44_9),
    .hcount(hcount[11:0]),
    .vcount(vcount[9:0])
);
  shader u_shader (
    .clk_pix(clk_pix),
    .rst_pix(rst_pix),
    .n44_9(n44_9),
    .n43_7(n43_7),
    .n42_7(n42_7),
    .n41_7(n41_7),
    .n40_7(n40_7),
    .n39_7(n39_7),
    .n38_7(n38_7),
    .n37_7(n37_7),
    .n36_7(n36_7),
    .n35_7(n35_7),
    .n34_7(n34_7),
    .n33_7(n33_7),
    .n11_9(n11_9),
    .de_Z(de_Z),
    .n35_8(n35_8),
    .de_Z_6(de_Z_6),
    .n38_8(n38_8),
    .hcount(hcount[11:0]),
    .vcount(vcount[9:0]),
    .sun_dx_4_4(sun_dx_4_4),
    .b_Z(b_Z[7:0]),
    .g_Z(g_Z[7:0]),
    .r_Z(r_Z[7:0])
);
  DVI_TX_Top u_dvi_tx (
    .clk_pix(clk_pix),
    .clk_ser(clk_ser),
    .rst_n_d(rst_n_d),
    .de_Z(de_Z),
