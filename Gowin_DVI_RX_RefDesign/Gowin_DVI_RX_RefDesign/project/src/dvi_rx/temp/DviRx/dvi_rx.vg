`pragma protect end_protected
module DVI_RX_Top (
  I_rst_n,
  I_tmds_clk_p,
  I_tmds_clk_n,
  I_tmds_data_p,
  I_tmds_data_n,
  O_pll_lock,
  O_pll_phase,
  O_pll_phase_lock,
  O_rgb_clk,
  O_rgb_vs,
  O_rgb_hs,
  O_rgb_de,
  O_rgb_r,
  O_rgb_g,
  O_rgb_b
)
;
input I_rst_n;
input I_tmds_clk_p;
input I_tmds_clk_n;
input [2:0] I_tmds_data_p;
input [2:0] I_tmds_data_n;
output O_pll_lock;
output [3:0] O_pll_phase;
output O_pll_phase_lock;
output O_rgb_clk;
output O_rgb_vs;
output O_rgb_hs;
output O_rgb_de;
output [7:0] O_rgb_r;
output [7:0] O_rgb_g;
output [7:0] O_rgb_b;
wire VCC;
wire GND;
  \~dvi2rgb.DVI_RX_Top  dvi2rgb_inst (
    .I_tmds_clk_p(I_tmds_clk_p),
    .I_tmds_clk_n(I_tmds_clk_n),
    .I_rst_n(I_rst_n),
    .I_tmds_data_p(I_tmds_data_p[2:0]),
    .I_tmds_data_n(I_tmds_data_n[2:0]),
    .O_pll_lock(O_pll_lock),
    .O_rgb_clk(O_rgb_clk),
    .O_rgb_vs(O_rgb_vs),
    .O_rgb_de(O_rgb_de),
    .O_rgb_hs(O_rgb_hs),
    .O_pll_phase_lock(O_pll_phase_lock),
    .O_rgb_r(O_rgb_r[7:0]),
    .O_rgb_g(O_rgb_g[7:0]),
    .O_rgb_b(O_rgb_b[7:0]),
    .O_pll_phase(O_pll_phase[3:1])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
assign O_pll_phase[0] = GND;
endmodule /* DVI_RX_Top */
