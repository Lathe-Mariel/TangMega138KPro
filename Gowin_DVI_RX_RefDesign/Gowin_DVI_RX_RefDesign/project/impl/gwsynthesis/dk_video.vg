  run_cnt,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input I_clk_d;
input I_scl_d;
input tenth_clk;
input [5:4] O_led_d;
input [3:1] pll_phase;
