module EDID_PROM_Top (
  tenth_clk,
  I_scl_d,
  O_led_d,
  mem_rst_4,
  IO_sda
)
;
input tenth_clk;
input I_scl_d;
input [5:5] O_led_d;
output mem_rst_4;
inout IO_sda;
wire IO_sda_in;
wire sda_5;
wire VCC;
wire GND;
