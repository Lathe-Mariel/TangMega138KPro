module DVI_RX_Top (
  I_tmds_clk_p,
  I_tmds_clk_n,
  I_tmds_data_p,
  I_tmds_data_n,
  rx0_vsync,
  rx0_de,
  rx0_hsync,
  rx0_pclk,
  pll_phase_lock,
  rx0_r,
  rx0_g,
  rx0_b
)
;
input I_tmds_clk_p;
input I_tmds_clk_n;
input [2:0] I_tmds_data_p;
input [2:0] I_tmds_data_n;
output rx0_vsync;
output rx0_de;
output rx0_hsync;
output rx0_pclk;
output pll_phase_lock;
output [7:0] rx0_r;
output [7:0] rx0_g;
output [7:0] rx0_b;
wire VCC;
wire GND;
  \~dvi2rgb.DVI_RX_Top  dvi2rgb_inst (
    .I_tmds_clk_p(I_tmds_clk_p),
    .I_tmds_clk_n(I_tmds_clk_n),
    .I_tmds_data_p(I_tmds_data_p[2:0]),
    .I_tmds_data_n(I_tmds_data_n[2:0]),
    .rx0_vsync(rx0_vsync),
    .rx0_de(rx0_de),
    .rx0_hsync(rx0_hsync),
    .rx0_pclk(rx0_pclk),
    .pll_phase_lock(pll_phase_lock),
    .rx0_r(rx0_r[7:0]),
    .rx0_g(rx0_g[7:0]),
    .rx0_b(rx0_b[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_RX_Top */
module Gowin_PLL (
  rx0_pclk,
  pll_lock,
  serial_clk
)
;
input rx0_pclk;
output pll_lock;
output serial_clk;
wire clkout1;
wire clkout2;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
