    .control0_4(control0_0[4]),
    .control0_5(control0_0[5]),
    .module_id_reg(module_id_reg[3:0])
);
  ao_top_0 u_la0_top (
    .n24_6(n24_6),
    .I_clk_d(I_clk_d),
    .f5(f5),
    .I_scl_d(I_scl_d),
