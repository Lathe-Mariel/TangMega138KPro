output [2:0] O_tmds_data_n;
inout IO_sda;
input I_scl;
output fan;
output HPD;
output mux_s0;
output mux_s1;
output mux_s2;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
output tdo_pad_o;
