module DVI_TX_Top (
  rx0_pclk,
  serial_clk,
  hdmi4_rst_n,
  rx0_de,
  rx0_vsync,
  rx0_hsync,
  rx0_r,
  rx0_g,
  rx0_b,
  O_tmds_clk_p,
  O_tmds_clk_n,
  O_tmds_data_p,
  O_tmds_data_n
)
;
input rx0_pclk;
input serial_clk;
input hdmi4_rst_n;
input rx0_de;
input rx0_vsync;
input rx0_hsync;
input [7:0] rx0_r;
input [7:0] rx0_g;
input [7:0] rx0_b;
output O_tmds_clk_p;
output O_tmds_clk_n;
output [2:0] O_tmds_data_p;
output [2:0] O_tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .rx0_pclk(rx0_pclk),
    .serial_clk(serial_clk),
    .hdmi4_rst_n(hdmi4_rst_n),
    .rx0_de(rx0_de),
    .rx0_vsync(rx0_vsync),
    .rx0_hsync(rx0_hsync),
    .rx0_r(rx0_r[7:0]),
    .rx0_g(rx0_g[7:0]),
    .rx0_b(rx0_b[7:0]),
    .O_tmds_clk_p(O_tmds_clk_p),
    .O_tmds_clk_n(O_tmds_clk_n),
    .O_tmds_data_p(O_tmds_data_p[2:0]),
    .O_tmds_data_n(O_tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module video_top (
  I_clk,
  rst_sw,
  sw0,
  O_led,
  I_tmds_clk_p,
  I_tmds_clk_n,
  I_tmds_data_p,
  I_tmds_data_n,
  O_tmds_clk_p,
  O_tmds_clk_n,
  O_tmds_data_p,
  O_tmds_data_n,
  IO_sda,
  I_scl,
  fan,
  HPD,
  mux_s0,
  mux_s1,
  mux_s2,
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  tdo_pad_o
)
;
input I_clk;
input rst_sw;
input sw0;
output [5:0] O_led;
input I_tmds_clk_p;
input I_tmds_clk_n;
