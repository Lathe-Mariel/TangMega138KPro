module DVI_RX_Top (
  I_tmds_clk_p,
  I_tmds_clk_n,
  I_tmds_data_p,
  I_tmds_data_n,
  O_led_d,
  rx0_vsync,
  rx0_de,
  rx0_hsync,
  rx0_pclk,
  pll_phase_lock,
  rx0_r,
  rx0_g,
  rx0_b,
  pll_phase
)
;
input I_tmds_clk_p;
input I_tmds_clk_n;
input [2:0] I_tmds_data_p;
input [2:0] I_tmds_data_n;
input [5:5] O_led_d;
output rx0_vsync;
output rx0_de;
output rx0_hsync;
output rx0_pclk;
output pll_phase_lock;
output [7:0] rx0_r;
output [7:0] rx0_g;
output [7:0] rx0_b;
output [3:1] pll_phase;
wire VCC;
wire GND;
  \~dvi2rgb.DVI_RX_Top  dvi2rgb_inst (
    .I_tmds_clk_p(I_tmds_clk_p),
    .I_tmds_clk_n(I_tmds_clk_n),
    .I_tmds_data_p(I_tmds_data_p[2:0]),
    .I_tmds_data_n(I_tmds_data_n[2:0]),
    .O_led_d(O_led_d[5]),
    .rx0_vsync(rx0_vsync),
    .rx0_de(rx0_de),
    .rx0_hsync(rx0_hsync),
    .rx0_pclk(rx0_pclk),
    .pll_phase_lock(pll_phase_lock),
    .rx0_r(rx0_r[7:0]),
    .rx0_g(rx0_g[7:0]),
    .rx0_b(rx0_b[7:0]),
    .pll_phase(pll_phase[3:1])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_RX_Top */
module Gowin_PLL (
  rx0_pclk,
  pll_lock,
  serial_clk
)
;
input rx0_pclk;
output pll_lock;
output serial_clk;
wire clkout1;
wire clkout2;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
wire VCC;
wire GND;
  PLL PLL_inst (
    .LOCK(pll_lock),
    .CLKOUT0(serial_clk),
    .CLKOUT1(clkout1),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(rx0_pclk),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .MDSEL_FRAC({GND,GND,GND}),
    .ODSEL0({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL0_FRAC({GND,GND,GND}),
    .ODSEL1({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL2({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL3({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL4({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL5({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL6({GND,GND,GND,GND,GND,GND,GND}),
    .DT0({GND,GND,GND,GND}),
    .DT1({GND,GND,GND,GND}),
    .DT2({GND,GND,GND,GND}),
    .DT3({GND,GND,GND,GND}),
    .ICPSEL({GND,GND,GND,GND,GND,GND}),
    .LPFRES({GND,GND,GND}),
    .LPFCAP({GND,GND}),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .ENCLK0(VCC),
    .ENCLK1(VCC),
    .ENCLK2(VCC),
    .ENCLK3(VCC),
    .ENCLK4(VCC),
    .ENCLK5(VCC),
    .ENCLK6(VCC),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}) 
);
