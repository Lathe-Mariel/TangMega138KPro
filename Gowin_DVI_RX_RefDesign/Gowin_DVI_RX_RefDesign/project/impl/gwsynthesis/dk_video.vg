module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  I_clk_d,
  I_scl_d,
  tenth_clk,
  O_led_d,
  pll_phase,
  run_cnt,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input I_clk_d;
input I_scl_d;
input tenth_clk;
input [5:4] O_led_d;
input [3:1] pll_phase;
input [1:1] run_cnt;
output tdo_pad_o;
wire tms_i_c;
wire tck_i_c;
wire tdi_i_c;
wire tdo_o_c;
wire gao_jtag_tdi;
wire gao_jtag_reset;
wire run_test_idle_er1;
wire run_test_idle_er2;
