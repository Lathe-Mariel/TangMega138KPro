    .tenth_clk(tenth_clk),
    .IO_sda_in(IO_sda_in),
    .I_scl_d(I_scl_d),
    .O_led_d(O_led_d[5]),
    .sda_5(sda_5),
    .mem_rst_4(mem_rst_4)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* EDID_PROM_Top */
