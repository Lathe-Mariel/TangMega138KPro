wire O_led_d_1_4;
wire n122_6;
wire mem_rst_4;
wire rx0_vsync;
wire rx0_de;
wire rx0_hsync;
wire rx0_pclk;
wire pll_phase_lock;
wire pll_lock;
wire serial_clk;
wire [5:0] O_led_d;
wire [25:0] run_cnt;
wire [2:0] div_counter;
wire [7:0] rx0_r;
wire [7:0] rx0_g;
wire [7:0] rx0_b;
wire [3:1] pll_phase;
wire VCC;
wire GND;
  IBUF I_clk_ibuf (
    .O(I_clk_d),
    .I(I_clk) 
);
  IBUF rst_sw_ibuf (
    .O(O_led_d[4]),
    .I(rst_sw) 
);
  IBUF sw0_ibuf (
    .O(O_led_d[5]),
    .I(sw0) 
);
  IBUF I_scl_ibuf (
    .O(I_scl_d),
    .I(I_scl) 
);
  OBUF O_led_0_obuf (
    .O(O_led[0]),
    .I(O_led_d[0]) 
);
