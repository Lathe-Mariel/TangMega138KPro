wire GND;
  PLL PLL_inst (
    .LOCK(pll_lock),
    .CLKOUT0(serial_clk),
    .CLKOUT1(clkout1),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
