`pragma protect end_protected
module DVI_RX_Top (
  rst_n_d,
  clk_d,
  tmds_rx_d_p,
  tmds_rx_d_n,
  rx_vsync,
  rx_pclk,
  state_led_d,
  rx_r,
  rx_g,
  rx_b
)
;
input rst_n_d;
input clk_d;
input [2:0] tmds_rx_d_p;
input [2:0] tmds_rx_d_n;
output rx_vsync;
output rx_pclk;
