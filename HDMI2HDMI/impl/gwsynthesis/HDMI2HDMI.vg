module DDR3_Memory_Interface_Top (
  cmd_en,
  wr_data_end,
  clk_100,
  memory_clk,
  rst_n_d,
  memory_pll_lock,
  cmd,
  addr,
  wr_data,
  rd_data_valid,
  cmd_ready,
  wr_data_rdy,
  dma_clk,
  ddr_ck,
  ddr_ck_n,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  init_calib_complete,
  ddr_addr,
  ddr_bank,
  rd_data,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input cmd_en;
input wr_data_end;
input clk_100;
input memory_clk;
input rst_n_d;
input memory_pll_lock;
input [0:0] cmd;
input [27:3] addr;
input [255:0] wr_data;
output rd_data_valid;
output cmd_ready;
output wr_data_rdy;
output dma_clk;
output ddr_ck;
output ddr_ck_n;
output ddr_cs;
output ddr_ras;
output ddr_cas;
output ddr_we;
output init_calib_complete;
