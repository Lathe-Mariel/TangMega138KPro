`pragma protect end_protected
module DVI_RX_Top (
  rst_n_d,
  tmds_rx_d_p,
  tmds_rx_d_n,
  rx_vsync,
  rx_pclk,
  state_led_d,
  rx_r,
  rx_g,
  rx_b
)
;
input rst_n_d;
input [2:0] tmds_rx_d_p;
input [2:0] tmds_rx_d_n;
output rx_vsync;
output rx_pclk;
output [4:4] state_led_d;
output [7:0] rx_r;
output [7:0] rx_g;
output [7:0] rx_b;
wire VCC;
wire GND;
  \~dvi2rgb.DVI_RX_Top  dvi2rgb_inst (
    .rst_n_d(rst_n_d),
    .tmds_rx_d_p(tmds_rx_d_p[2:0]),
    .tmds_rx_d_n(tmds_rx_d_n[2:0]),
    .rx_vsync(rx_vsync),
    .rx_pclk(rx_pclk),
    .state_led_d(state_led_d[4]),
    .rx_r(rx_r[7:0]),
    .rx_g(rx_g[7:0]),
    .rx_b(rx_b[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
