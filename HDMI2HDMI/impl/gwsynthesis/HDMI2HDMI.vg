module DVI_TX_Top (
  cmos_xclk_d,
  clk_5x,
  rst_n_d,
  tmds_tx_clk_p,
  tmds_tx_clk_n,
  tmds_tx_data_p,
  tmds_tx_data_n
)
;
input cmos_xclk_d;
input clk_5x;
input rst_n_d;
output tmds_tx_clk_p;
output tmds_tx_clk_n;
output [2:0] tmds_tx_data_p;
output [2:0] tmds_tx_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .cmos_xclk_d(cmos_xclk_d),
    .clk_5x(clk_5x),
    .rst_n_d(rst_n_d),
    .tmds_tx_clk_p(tmds_tx_clk_p),
    .tmds_tx_clk_n(tmds_tx_clk_n),
    .tmds_tx_data_p(tmds_tx_data_p[2:0]),
    .tmds_tx_data_n(tmds_tx_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module dvi_frame_buffer_top (
  clk,
  rst_n,
  tmds_rx_clk_p,
  tmds_rx_clk_n,
  tmds_rx_d_p,
  tmds_rx_d_n,
  tmds_tx_clk_p,
  tmds_tx_clk_n,
  tmds_tx_data_p,
  tmds_tx_data_n,
  ddr_addr,
  ddr_bank,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_odt,
  ddr_cke,
  ddr_reset_n,
  ddr_ck,
  ddr_ck_n,
  ddr_dq,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dm,
  cmos_pclk,
  cmos_href,
  cmos_vsync,
  cmos_db,
  cmos_xclk,
  cmos_rst_n,
  cmos_pwdn,
  cmos_scl,
  cmos_sda,
  state_led,
  sw0,
  sw1,
  fan
)
;
input clk;
input rst_n;
input tmds_rx_clk_p;
input tmds_rx_clk_n;
input [2:0] tmds_rx_d_p;
input [2:0] tmds_rx_d_n;
output tmds_tx_clk_p;
output tmds_tx_clk_n;
output [2:0] tmds_tx_data_p;
output [2:0] tmds_tx_data_n;
output [15:0] ddr_addr;
output [2:0] ddr_bank;
output ddr_cs;
output ddr_ras;
output ddr_cas;
output ddr_we;
output ddr_odt;
output ddr_cke;
output ddr_reset_n;
output ddr_ck;
output ddr_ck_n;
inout [31:0] ddr_dq;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
output [3:0] ddr_dm;
input cmos_pclk;
input cmos_href;
input cmos_vsync;
input [7:0] cmos_db;
output cmos_xclk;
output cmos_rst_n;
output cmos_pwdn;
inout cmos_scl;
inout cmos_sda;
output [5:0] state_led;
input sw0;
input sw1;
output fan;
wire clk_d;
wire rst_n_d;
wire n65_7;
wire clk_5x;
wire cmos_xclk_d;
wire memory_pll_lock;
wire memory_clk;
wire clk_100;
wire rx_vsync;
wire rx_pclk;
wire cmd_en;
wire wr_data_end;
wire rd_data_valid;
wire cmd_ready;
wire wr_data_rdy;
wire dma_clk;
wire init_calib_complete;
wire [4:4] state_led_d;
wire [7:0] rx_r;
wire [7:0] rx_g;
wire [7:0] rx_b;
wire [0:0] cmd;
wire [27:3] addr;
wire [255:0] wr_data;
wire [255:0] rd_data;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  OBUF ddr_addr_15_obuf (
    .O(ddr_addr[15]),
    .I(GND) 
);
  TBUF ddr_odt_s0 (
    .O(ddr_odt),
    .I(GND),
    .OEN(VCC) 
);
  TBUF ddr_cke_s0 (
    .O(ddr_cke),
    .I(GND),
    .OEN(VCC) 
);
  TBUF ddr_reset_n_s0 (
    .O(ddr_reset_n),
    .I(GND),
    .OEN(VCC) 
);
  TBUF ddr_dm_3_s0 (
    .O(ddr_dm[0]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF ddr_dm_3_s1 (
    .O(ddr_dm[1]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF ddr_dm_3_s2 (
    .O(ddr_dm[2]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF ddr_dm_3_s3 (
    .O(ddr_dm[3]),
    .I(GND),
    .OEN(VCC) 
);
  OBUF cmos_xclk_obuf (
    .O(cmos_xclk),
    .I(cmos_xclk_d) 
);
  OBUF cmos_rst_n_obuf (
    .O(cmos_rst_n),
    .I(GND) 
);
  OBUF cmos_pwdn_obuf (
    .O(cmos_pwdn),
    .I(GND) 
);
  OBUF state_led_0_obuf (
    .O(state_led[0]),
    .I(GND) 
);
  OBUF state_led_1_obuf (
    .O(state_led[1]),
    .I(GND) 
);
  TBUF state_led_5_s1 (
    .O(state_led[2]),
    .I(GND),
    .OEN(VCC) 
);
  TBUF state_led_5_s2 (
    .O(state_led[3]),
    .I(GND),
    .OEN(VCC) 
);
  OBUF state_led_4_obuf (
    .O(state_led[4]),
    .I(state_led_d[4]) 
);
  OBUF state_led_5_obuf (
    .O(state_led[5]),
    .I(GND) 
);
  OBUF fan_obuf (
    .O(fan),
    .I(VCC) 
);
  INV n65_s2 (
    .O(n65_7),
    .I(rx_vsync) 
);
  Gowin_PLL_DVI pll_dvi (
    .clk_d(clk_d),
    .clk_5x(clk_5x)
);
  Gowin_CLKDIV clkdiv_dvi (
    .clk_5x(clk_5x),
    .rst_n_d(rst_n_d),
    .cmos_xclk_d(cmos_xclk_d)
);
  Gowin_PLL pll_memory (
    .clk_d(clk_d),
    .rst_n_d(rst_n_d),
    .memory_pll_lock(memory_pll_lock),
    .memory_clk(memory_clk),
    .clk_100(clk_100)
);
  DVI_RX_Top dvi_rx_instance (
    .rst_n_d(rst_n_d),
    .tmds_rx_d_p(tmds_rx_d_p[2:0]),
    .tmds_rx_d_n(tmds_rx_d_n[2:0]),
    .rx_vsync(rx_vsync),
    .rx_pclk(rx_pclk),
    .state_led_d(state_led_d[4]),
    .rx_r(rx_r[7:0]),
    .rx_g(rx_g[7:0]),
    .rx_b(rx_b[7:0])
);
  Video_Frame_Buffer_Top vfb_instance (
    .rst_n_d(rst_n_d),
    .init_calib_complete(init_calib_complete),
    .dma_clk(dma_clk),
    .n65_7(n65_7),
    .cmd_ready(cmd_ready),
    .wr_data_rdy(wr_data_rdy),
    .rx_pclk(rx_pclk),
    .rd_data_valid(rd_data_valid),
    .cmos_xclk_d(cmos_xclk_d),
    .rd_data(rd_data[255:0]),
    .state_led_d(state_led_d[4]),
    .rx_r(rx_r[7:0]),
    .rx_g(rx_g[7:0]),
    .rx_b(rx_b[7:0]),
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .cmd(cmd[0]),
    .addr(addr[27:3]),
    .wr_data(wr_data[255:0])
);
  DDR3_Memory_Interface_Top your_instance_name (
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .clk_100(clk_100),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .memory_pll_lock(memory_pll_lock),
    .cmd(cmd[0]),
    .addr(addr[27:3]),
    .wr_data(wr_data[255:0]),
    .rd_data_valid(rd_data_valid),
    .cmd_ready(cmd_ready),
    .wr_data_rdy(wr_data_rdy),
    .dma_clk(dma_clk),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_cs(ddr_cs),
    .ddr_ras(ddr_ras),
    .ddr_cas(ddr_cas),
    .ddr_we(ddr_we),
    .init_calib_complete(init_calib_complete),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .rd_data(rd_data[255:0]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  DVI_TX_Top dvi_tx_instance (
    .cmos_xclk_d(cmos_xclk_d),
    .clk_5x(clk_5x),
    .rst_n_d(rst_n_d),
    .tmds_tx_clk_p(tmds_tx_clk_p),
    .tmds_tx_clk_n(tmds_tx_clk_n),
    .tmds_tx_data_p(tmds_tx_data_p[2:0]),
    .tmds_tx_data_n(tmds_tx_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* dvi_frame_buffer_top */
