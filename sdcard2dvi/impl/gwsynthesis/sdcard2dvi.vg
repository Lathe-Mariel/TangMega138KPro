module DDR3_Memory_Interface_Top (
  cmd_en,
  wr_data_end,
  clk_100,
  memory_clk,
  rst_n_d,
  cmd,
  addr,
  wr_data,
  state_led_d,
  rd_data_valid,
  cmd_ready,
  wr_data_rdy,
  dma_clk,
  n7_6,
  ddr_ck,
  ddr_ck_n,
  ddr_reset_n,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_cke,
  ddr_odt,
  ddr_dm,
  ddr_addr,
  ddr_bank,
  rd_data,
  state_led_d_17,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input cmd_en;
input wr_data_end;
input clk_100;
input memory_clk;
input rst_n_d;
input [0:0] cmd;
input [27:3] addr;
input [255:0] wr_data;
input [0:0] state_led_d;
output rd_data_valid;
output cmd_ready;
output wr_data_rdy;
output dma_clk;
output n7_6;
output ddr_ck;
output ddr_ck_n;
output ddr_reset_n;
output ddr_cs;
output ddr_ras;
output ddr_cas;
output ddr_we;
output ddr_cke;
output ddr_odt;
output [3:0] ddr_dm;
output [14:0] ddr_addr;
output [2:0] ddr_bank;
output [255:0] rd_data;
output [1:1] state_led_d_17;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
inout [31:0] ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3_Memory_Interface_Top  gw3_top (
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .clk_100(clk_100),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .cmd(cmd[0]),
    .addr(addr[27:3]),
    .wr_data(wr_data[255:0]),
    .state_led_d(state_led_d[0]),
    .rd_data_valid(rd_data_valid),
    .cmd_ready(cmd_ready),
    .wr_data_rdy(wr_data_rdy),
    .dma_clk(dma_clk),
    .n7_6(n7_6),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs(ddr_cs),
    .ddr_ras(ddr_ras),
    .ddr_cas(ddr_cas),
    .ddr_we(ddr_we),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .ddr_dm(ddr_dm[3:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .rd_data(rd_data[255:0]),
    .state_led_d_16(state_led_d_17[1]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3_Memory_Interface_Top */
