output [1:1] state_led_d_17;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
inout [31:0] ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3_Memory_Interface_Top  gw3_top (
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .clk_100(clk_100),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
