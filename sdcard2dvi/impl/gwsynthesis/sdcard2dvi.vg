module DDR3_Memory_Interface_Top (
  cmd_en,
  wr_data_end,
  clk_d,
  memory_clk,
  rst_n_d,
  cmd,
  addr,
  wr_data,
  state_led_d,
  rd_data_valid,
  cmd_ready,
  wr_data_rdy,
  dma_clk,
  n7_6,
  ddr_ck,
  ddr_ck_n,
  ddr_reset_n,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_cke,
  ddr_odt,
  ddr_dm,
  ddr_addr,
  ddr_bank,
  rd_data,
  state_led_d_17,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
