    .wr_data_rdy(wr_data_rdy),
    .dma_clk(dma_clk),
    .n7_6(n7_6),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs(ddr_cs),
    .ddr_ras(ddr_ras),
    .ddr_cas(ddr_cas),
    .ddr_we(ddr_we),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .ddr_dm(ddr_dm[3:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .rd_data(rd_data[255:0]),
    .state_led_d_16(state_led_d_17[1]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3_Memory_Interface_Top */
