  ddr_dm,
  ddr_addr,
  ddr_bank,
  rd_data,
  state_led_d_17,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input cmd_en;
input wr_data_end;
input clk_d;
input memory_clk;
input rst_n_d;
input [0:0] cmd;
input [27:3] addr;
input [255:0] wr_data;
input [0:0] state_led_d;
output rd_data_valid;
