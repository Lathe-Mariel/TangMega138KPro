  clk_5x,
  state
)
;
input clk_d;
input n7_6;
output pll_lock;
output clk_5x;
output [2:0] state;
wire pll_rst;
wire [2:0] lpfres;
wire [1:0] icpsel;
wire VCC;
wire GND;
  Gowin_PLL_DVI_MOD u_pll (
    .clk_d(clk_d),
    .pll_rst(pll_rst),
    .icpsel(icpsel[1:0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock),
    .clk_5x(clk_5x)
);
  PLL_INIT u_pll_init (
    .clk_d(clk_d),
    .n7_6(n7_6),
    .pll_lock(pll_lock),
    .pll_rst(pll_rst),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[1:0]),
    .state(state[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_PLL_DVI */
