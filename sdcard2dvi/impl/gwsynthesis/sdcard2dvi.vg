module DDR3_Memory_Interface_Top (
  cmd_en,
  wr_data_end,
  clk_100,
  memory_clk,
  rst_n_d,
  memory_pll_lock,
  cmd,
  addr,
  wr_data,
  rd_data_valid,
  cmd_ready,
  wr_data_rdy,
  dma_clk,
  n7_6,
  ddr_ck,
  ddr_ck_n,
  ddr_reset_n,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_cke,
  ddr_odt,
  init_calib_complete,
  ddr_dm,
  ddr_addr,
  ddr_bank,
  rd_data,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input cmd_en;
input wr_data_end;
input clk_100;
input memory_clk;
input rst_n_d;
input memory_pll_lock;
input [0:0] cmd;
input [27:3] addr;
input [255:0] wr_data;
output rd_data_valid;
output cmd_ready;
output wr_data_rdy;
output dma_clk;
output n7_6;
output ddr_ck;
output ddr_ck_n;
output ddr_reset_n;
output ddr_cs;
output ddr_ras;
output ddr_cas;
output ddr_we;
output ddr_cke;
output ddr_odt;
output init_calib_complete;
output [3:0] ddr_dm;
output [14:0] ddr_addr;
output [2:0] ddr_bank;
output [255:0] rd_data;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
inout [31:0] ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3_Memory_Interface_Top  gw3_top (
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .clk_100(clk_100),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .memory_pll_lock(memory_pll_lock),
    .cmd(cmd[0]),
    .addr(addr[27:3]),
    .wr_data(wr_data[255:0]),
    .rd_data_valid(rd_data_valid),
    .cmd_ready(cmd_ready),
    .wr_data_rdy(wr_data_rdy),
    .dma_clk(dma_clk),
    .n7_6(n7_6),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs(ddr_cs),
    .ddr_ras(ddr_ras),
    .ddr_cas(ddr_cas),
    .ddr_we(ddr_we),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .init_calib_complete(init_calib_complete),
    .ddr_dm(ddr_dm[3:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .rd_data(rd_data[255:0]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3_Memory_Interface_Top */
module vga_timing (
  clk_pixel,
  n36_6,
  sys_rst_n,
  out_de,
  out_hsync,
  out_vsync
)
;
input clk_pixel;
input n36_6;
input sys_rst_n;
output out_de;
output out_hsync;
output out_vsync;
wire n189_3;
wire n11_8;
wire n43_7;
wire n41_7;
wire n40_7;
wire n39_7;
wire n38_7;
wire n37_7;
wire n36_7;
wire n35_7;
wire n34_7;
wire n33_7;
wire n11_9;
wire n11_10;
wire n11_11;
wire out_de_3;
wire out_de_4;
wire out_hsync_4;
wire out_hsync_5;
wire out_vsync_4;
wire out_vsync_5;
wire out_vsync_6;
wire n43_8;
wire n42_8;
wire n39_8;
wire n37_8;
wire n36_8;
wire n33_8;
wire out_de_5;
wire out_hsync_6;
wire n43_9;
wire out_hsync_7;
wire n42_10;
wire n56_1;
wire n56_2;
wire n55_1;
wire n55_2;
wire n54_1;
wire n54_2;
wire n53_1;
wire n53_2;
wire n52_1;
wire n52_2;
wire n51_1;
wire n51_2;
wire n50_1;
wire n50_2;
wire n49_1;
wire n49_2;
wire n48_1;
wire n48_2;
wire n47_1;
wire n47_2;
wire n46_1;
wire n46_0_COUT;
wire n44_9;
wire n57_6;
wire [11:0] h_cnt;
wire [11:0] v_cnt;
wire VCC;
wire GND;
  LUT2 n189_s0 (
    .F(n189_3),
    .I0(n11_8),
    .I1(sys_rst_n) 
);
defparam n189_s0.INIT=4'hB;
  LUT4 n11_s5 (
    .F(n11_8),
    .I0(n11_9),
    .I1(h_cnt[5]),
    .I2(n11_10),
    .I3(n11_11) 
);
defparam n11_s5.INIT=16'h8000;
  LUT4 out_de_s (
    .F(out_de),
    .I0(v_cnt[8]),
    .I1(out_de_3),
    .I2(v_cnt[9]),
    .I3(out_de_4) 
);
defparam out_de_s.INIT=16'h1F00;
  LUT4 out_hsync_s (
    .F(out_hsync),
    .I0(h_cnt[9]),
    .I1(out_hsync_4),
    .I2(out_hsync_5),
    .I3(h_cnt[8]) 
);
defparam out_hsync_s.INIT=16'hEFFF;
  LUT4 out_vsync_s (
    .F(out_vsync),
    .I0(out_vsync_4),
    .I1(v_cnt[4]),
    .I2(out_vsync_5),
    .I3(out_vsync_6) 
);
defparam out_vsync_s.INIT=16'hBFFF;
  LUT3 n43_s2 (
    .F(n43_7),
    .I0(n43_8),
    .I1(v_cnt[0]),
    .I2(v_cnt[1]) 
);
defparam n43_s2.INIT=8'h14;
  LUT4 n41_s2 (
    .F(n41_7),
    .I0(v_cnt[2]),
    .I1(n42_8),
    .I2(n43_8),
    .I3(v_cnt[3]) 
);
defparam n41_s2.INIT=16'h0708;
  LUT4 n40_s2 (
    .F(n40_7),
    .I0(v_cnt[2]),
    .I1(v_cnt[3]),
    .I2(n42_8),
    .I3(v_cnt[4]) 
);
defparam n40_s2.INIT=16'h7F80;
  LUT3 n39_s2 (
    .F(n39_7),
    .I0(n43_8),
    .I1(v_cnt[5]),
    .I2(n39_8) 
);
defparam n39_s2.INIT=8'h14;
  LUT4 n38_s2 (
    .F(n38_7),
    .I0(v_cnt[5]),
    .I1(n39_8),
    .I2(n43_8),
    .I3(v_cnt[6]) 
);
defparam n38_s2.INIT=16'h0708;
  LUT3 n37_s2 (
    .F(n37_7),
    .I0(n43_8),
    .I1(n37_8),
    .I2(v_cnt[7]) 
);
defparam n37_s2.INIT=8'h14;
  LUT2 n36_s2 (
    .F(n36_7),
    .I0(v_cnt[8]),
    .I1(n36_8) 
);
defparam n36_s2.INIT=4'h6;
  LUT4 n35_s2 (
    .F(n35_7),
    .I0(v_cnt[8]),
    .I1(n36_8),
    .I2(n43_8),
    .I3(v_cnt[9]) 
);
defparam n35_s2.INIT=16'h0708;
  LUT4 n34_s2 (
    .F(n34_7),
    .I0(v_cnt[8]),
    .I1(v_cnt[9]),
    .I2(n36_8),
    .I3(v_cnt[10]) 
);
defparam n34_s2.INIT=16'h7F80;
  LUT3 n33_s2 (
    .F(n33_7),
    .I0(n36_8),
    .I1(n33_8),
    .I2(v_cnt[11]) 
);
defparam n33_s2.INIT=8'h78;
  LUT3 n11_s6 (
    .F(n11_9),
    .I0(h_cnt[11]),
    .I1(h_cnt[10]),
    .I2(h_cnt[6]) 
);
defparam n11_s6.INIT=8'h40;
  LUT4 n11_s7 (
    .F(n11_10),
    .I0(h_cnt[7]),
    .I1(h_cnt[8]),
    .I2(h_cnt[4]),
    .I3(h_cnt[9]) 
);
defparam n11_s7.INIT=16'h1000;
  LUT4 n11_s8 (
    .F(n11_11),
    .I0(h_cnt[1]),
    .I1(h_cnt[2]),
    .I2(h_cnt[3]),
    .I3(h_cnt[0]) 
);
defparam n11_s8.INIT=16'h0100;
  LUT4 out_de_s0 (
    .F(out_de_3),
    .I0(v_cnt[5]),
    .I1(v_cnt[4]),
    .I2(v_cnt[6]),
    .I3(v_cnt[7]) 
);
defparam out_de_s0.INIT=16'hE000;
  LUT4 out_de_s1 (
    .F(out_de_4),
    .I0(out_de_5),
    .I1(h_cnt[11]),
    .I2(v_cnt[10]),
    .I3(v_cnt[11]) 
);
defparam out_de_s1.INIT=16'h0001;
  LUT4 out_hsync_s0 (
    .F(out_hsync_4),
    .I0(out_hsync_6),
    .I1(h_cnt[7]),
    .I2(h_cnt[6]),
    .I3(h_cnt[5]) 
);
defparam out_hsync_s0.INIT=16'hDFFB;
  LUT2 out_hsync_s1 (
    .F(out_hsync_5),
    .I0(h_cnt[11]),
    .I1(h_cnt[10]) 
