IO_PORT "sw0"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "sw1"  G15;
IO_PORT "sw1"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//------------------------------------------------------------------------------
// Fan Control
//------------------------------------------------------------------------------

IO_LOC  "fan"  T18;
IO_PORT "fan"  IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

