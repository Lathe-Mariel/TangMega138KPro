//==============================================================================
// GOWIN Constraint File (.cst)
// Project  : DVI Frame Buffer with Image Composer
// Board    : Tang Mega 138K Pro Dock
// Device   : GW5AST-LV138FPG676A
// Updated  : 2026-04-04
//==============================================================================

//------------------------------------------------------------------------------
// System Clock & Reset
//------------------------------------------------------------------------------

IO_LOC  "clk"    P16;                                             // 50 MHz system clock
IO_PORT "clk"    IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "rst_n"  K16;
IO_PORT "rst_n"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//------------------------------------------------------------------------------
// HDMI RX (Input) - TMDS Differential Pairs
//   Note: GOWIN DVI RX IP uses individual P/N port declarations
//------------------------------------------------------------------------------

// TMDS Clock Input

//------------------------------------------------------------------------------
// HDMI TX (Output) - TMDS Differential Pairs
//   Note: GOWIN DVI TX IP uses combined P,N pin notation for differential pairs
//------------------------------------------------------------------------------

// TMDS Clock Output
IO_LOC  "tmds_tx_clk_p"       Y22,Y23;
IO_PORT "tmds_tx_clk_p"       IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

// TMDS Data Lane 0 (Blue channel)
IO_LOC  "tmds_tx_data_p[0]"   AB24,AC24;
IO_PORT "tmds_tx_data_p[0]"   IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

// TMDS Data Lane 1 (Green channel)
IO_LOC  "tmds_tx_data_p[1]"   V24,W24;
IO_PORT "tmds_tx_data_p[1]"   IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

// TMDS Data Lane 2 (Red channel)
IO_LOC  "tmds_tx_data_p[2]"   AA22,AA23;
IO_PORT "tmds_tx_data_p[2]"   IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=2.5;

//------------------------------------------------------------------------------
// DDR3 SDRAM - Address & Bank (SSTL15, 1.5V)
//------------------------------------------------------------------------------

IO_LOC  "ddr_addr[0]"   N1;
IO_PORT "ddr_addr[0]"   IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
