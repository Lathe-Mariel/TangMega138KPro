`pragma protect end_protected
module DDR3_Memory_Interface_Top (
  clk_100,
  memory_clk,
  rst_n_d,
  memory_pll_lock,
  ddr_ck,
  ddr_ck_n,
  ddr_reset_n,
  ddr_cs_n,
  ddr_ras_n,
  ddr_cas_n,
  ddr_we_n,
  ddr_cke,
  ddr_odt,
  ddr_dm,
  ddr_addr,
  ddr_bank,
  state_led_d,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input clk_100;
input memory_clk;
input rst_n_d;
input memory_pll_lock;
output ddr_ck;
output ddr_ck_n;
output ddr_reset_n;
output ddr_cs_n;
output ddr_ras_n;
output ddr_cas_n;
output ddr_we_n;
output ddr_cke;
output ddr_odt;
output [3:0] ddr_dm;
output [14:0] ddr_addr;
output [2:0] ddr_bank;
output [0:0] state_led_d;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
inout [31:0] ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3_Memory_Interface_Top  gw3_top (
    .clk_100(clk_100),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .memory_pll_lock(memory_pll_lock),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs_n(ddr_cs_n),
    .ddr_ras_n(ddr_ras_n),
    .ddr_cas_n(ddr_cas_n),
    .ddr_we_n(ddr_we_n),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .ddr_dm(ddr_dm[3:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .state_led_d(state_led_d[0]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3_Memory_Interface_Top */
module top (
  clk,
  rst_n,
  ddr_addr,
  ddr_bank,
  ddr_cs_n,
  ddr_ras_n,
  ddr_cas_n,
  ddr_we_n,
  ddr_ck,
  ddr_ck_n,
  ddr_cke,
  ddr_odt,
  ddr_reset_n,
  ddr_dm,
  ddr_dq,
  ddr_dqs,
  ddr_dqs_n,
  state_led
)
;
input clk;
input rst_n;
output [14:0] ddr_addr;
output [2:0] ddr_bank;
output ddr_cs_n;
output ddr_ras_n;
output ddr_cas_n;
output ddr_we_n;
output ddr_ck;
output ddr_ck_n;
output ddr_cke;
output ddr_odt;
output ddr_reset_n;
output [3:0] ddr_dm;
inout [31:0] ddr_dq;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
output [5:0] state_led;
wire clk_d;
wire rst_n_d;
wire n7_6;
wire memory_pll_lock;
wire memory_clk;
wire clk_100;
wire [0:0] state_led_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  OBUF state_led_0_obuf (
    .O(state_led[0]),
    .I(state_led_d[0]) 
);
  OBUF state_led_1_obuf (
    .O(state_led[1]),
    .I(GND) 
);
  OBUF state_led_2_obuf (
    .O(state_led[2]),
    .I(GND) 
);
  OBUF state_led_3_obuf (
    .O(state_led[3]),
    .I(GND) 
);
  OBUF state_led_4_obuf (
    .O(state_led[4]),
    .I(GND) 
);
  OBUF state_led_5_obuf (
    .O(state_led[5]),
    .I(GND) 
);
  INV n7_s2 (
    .O(n7_6),
    .I(rst_n_d) 
);
  Gowin_PLL u_pll (
    .clk_d(clk_d),
    .n7_6(n7_6),
    .memory_pll_lock(memory_pll_lock),
    .memory_clk(memory_clk),
    .clk_100(clk_100)
);
  DDR3_Memory_Interface_Top u_ddr3 (
    .clk_100(clk_100),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .memory_pll_lock(memory_pll_lock),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs_n(ddr_cs_n),
    .ddr_ras_n(ddr_ras_n),
    .ddr_cas_n(ddr_cas_n),
    .ddr_we_n(ddr_we_n),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .ddr_dm(ddr_dm[3:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .state_led_d(state_led_d[0]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
